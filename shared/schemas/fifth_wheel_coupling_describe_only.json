{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FifthWheelCouplingDescribeOnly",
  "description": "Describe-only output of the labeler. v5.6: side_view simplified to two primary signals; manufacturer-conditional sub-objects removed.",
  "type": "object",
  "required": ["inspection_type", "evidence_type", "image_quality", "verdict", "issues_detected", "factual_summary", "photo_matches_category"],
  "properties": {
    "inspection_type": { "const": "fifth_wheel_coupling" },
    "evidence_type": { "enum": ["side_view", "lock_jaws_underneath"] },
    "image_quality": { "enum": ["good", "acceptable", "poor"] },
    "verdict": { "const": "describe_only" },
    "issues_detected": { "type": "array", "maxItems": 0, "items": { "type": "string" } },
    "factual_summary": { "type": "string", "maxLength": 1000 },
    "photo_matches_category": { "enum": ["yes", "no", "unclear"] },
    "side_view": {
      "type": ["object", "null"],
      "required": [
        "trailer_seated_flush",
        "gap_between_apron_and_plate",
        "fifth_wheel_manufacturer"
      ],
      "properties": {
        "trailer_seated_flush": { "enum": ["yes", "no", "unclear"] },
        "gap_between_apron_and_plate": { "enum": ["none", "minor", "obvious", "not_visible"] },
        "fifth_wheel_manufacturer": { "enum": ["fontaine", "jost", "holland", "other", "unclear", "not_visible"] }
      }
    },
    "lock_jaws_underneath": {
      "type": ["object", "null"],
      "required": ["fifth_wheel_variant", "two_jaw_state", "single_bar_state", "kingpin_visible"],
      "properties": {
        "fifth_wheel_variant": { "enum": ["two_jaw", "single_bar", "unclear"] },
        "two_jaw_state": { "enum": ["fully_closed", "partially_open", "open", "not_applicable", "not_visible"] },
        "single_bar_state": { "enum": ["engaged_in_front_of_kingpin", "retracted", "not_applicable", "not_visible"] },
        "kingpin_visible": { "enum": ["yes", "no"] }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evidence_type": { "const": "side_view" } } },
      "then": { "required": ["side_view"], "properties": { "side_view": { "type": "object" }, "lock_jaws_underneath": { "type": "null" } } }
    },
    {
      "if": { "properties": { "evidence_type": { "const": "lock_jaws_underneath" } } },
      "then": { "required": ["lock_jaws_underneath"], "properties": { "lock_jaws_underneath": { "type": "object" }, "side_view": { "type": "null" } } }
    }
  ]
}
