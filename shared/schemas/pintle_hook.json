{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PintleHook",
  "description": "Inspection-level pintle-hook label. v5.5: adds photo_matches_category top-level self-check field; relaxes safety_chains_clipped_to_bar to at_least_one_clipped semantics matching uncle's actual inspection workflow on side-angle photos.",
  "type": "object",
  "required": ["inspection_type", "evidence_type", "image_quality", "verdict", "issues_detected", "factual_summary", "photo_matches_category", "rear_assembly"],
  "properties": {
    "inspection_type": { "const": "pintle_hook" },
    "evidence_type": { "const": "rear_assembly" },
    "image_quality": { "enum": ["good", "acceptable", "poor"] },
    "verdict": { "enum": ["pass", "fail", "unclear"] },
    "issues_detected": { "type": "array", "items": { "type": "string" } },
    "factual_summary": { "type": "string", "maxLength": 1000 },
    "photo_matches_category": { "enum": ["yes", "no", "unclear"] },
    "rear_assembly": {
      "type": "object",
      "required": [
        "hitch_latch_state",
        "safety_chains_count",
        "safety_chains_clipped_to_bar"
      ],
      "properties": {
        "hitch_latch_state": { "enum": ["closed", "open", "unclear", "not_visible"] },
        "safety_chains_count": {
          "anyOf": [
            { "type": "integer", "enum": [0, 1, 2] },
            { "type": "string", "enum": ["more_than_two", "not_visible"] }
          ]
        },
        "safety_chains_clipped_to_bar": {
          "enum": ["at_least_one_clipped", "none_clipped", "unclear", "not_visible"]
        }
      }
    }
  }
}
